# Copia este archivo como .env y configura los valores en tu equipo.
AI_PROVIDER=local
# Usa modelos disponibles en tu cuenta. Nunca compartas el archivo .env.
OPENAI_API_KEY=
OPENAI_MODEL=
# Modelo con visión. Si queda vacío, se utiliza OPENAI_MODEL.
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PORT=4317
# Opcional: Conectar-Tailscale.cmd completa esta URL en el equipo servidor.
# APP_ORIGIN=https://nombre-del-equipo.tu-red.ts.net:8443
